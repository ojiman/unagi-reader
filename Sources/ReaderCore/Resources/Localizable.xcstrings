    "Changes the article body and scales its headings. The list and note are unchanged.": {
      "comment": "Sources/UnagiReader/SettingsComponents.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the article body and scales its headings. The list and note are unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記事の本文の大きさです。見出しも同じ割合で変わります。一覧とノートは変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改文章正文大小，标题按相同比例缩放。列表和笔记不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改文章內文大小，標題按相同比例縮放。列表和筆記不變。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기사 본문 크기를 바꾸고 제목도 같은 비율로 조정합니다. 목록과 노트는 바뀌지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el tamaño del texto y escala los títulos. La lista y la nota no cambian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
