    "Article bodies: %lld. RSS summaries: %lld. About %@ will be deleted. The note is kept. Extending retention will not restore deleted bodies.": {
      "comment": "Sources/UnagiReader/ReaderSettingsView.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Article bodies: %lld. RSS summaries: %lld. About %@ will be deleted. The note is kept. Extending retention will not restore deleted bodies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文%lld件・RSS要約%lld件、約%@が削除対象です。ノートは残ります。削除した本文は保持期間を延長しても復元されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文章正文：%lld 篇。RSS 摘要：%lld 条。将删除约 %@。笔记会保留。延长保留期也无法恢复已删除的正文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文章內文：%lld 篇。RSS 摘要：%lld 則。將刪除約 %@。筆記會保留。延長保留期限也無法還原已刪除的內文。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기사 본문: %lld개. RSS 요약: %lld개. 약 %@가 삭제됩니다. 노트는 유지됩니다. 보관 기간을 늘려도 삭제된 본문은 복원되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Textos de artículos: %lld. Resúmenes RSS: %lld. Se eliminarán unos %@. La nota se conserva. Ampliar el plazo de conservación no restaura los textos eliminados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Textos de artigos: %lld. Resumos RSS: %lld. Cerca de %@ serão excluídos. A nota será mantida. Aumentar o prazo de retenção não restaura os textos excluídos."
          }
        }
      }
    },
